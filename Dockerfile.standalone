FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 ENABLE_WEB_INTERFACE=false HF_HUB_DISABLE_TELEMETRY=1 \
    WORKFLOW_STANDALONE=true WORKFLOW_AGENT_UID=10001 \
    WORKFLOW_WORKER_PATH=/app/agent_runtime/safe_worker.py
ARG RELEASE_REVISION
ENV WORKFLOW_RELEASE_REVISION=$RELEASE_REVISION
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock && \
    groupadd --gid 10001 agent && useradd --uid 10001 --gid 10001 --no-create-home agent
# Explicit whitelist. Never copy tests, author policies, traces or datasets.
COPY workflow_lab /app/workflow_lab
COPY workflow_controller /app/workflow_controller
RUN mkdir /app/agent_runtime && \
    cp /app/workflow_controller/safe_worker.py /app/agent_runtime/safe_worker.py && \
    chmod 755 /app/agent_runtime && chmod 644 /app/agent_runtime/safe_worker.py && \
    chmod 700 /app/workflow_controller && \
    find /app/workflow_controller -type f -exec chmod 600 {} +
# The server owns protected verifier files; agent programs drop to UID/GID 10001.
USER root
EXPOSE 8000
CMD ["python", "-m", "workflow_lab.app"]
