FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 ENABLE_WEB_INTERFACE=false HF_HUB_DISABLE_TELEMETRY=1
ARG CONTROLLER_URL=https://qingyuanwu-reconcile-workflow-controller.hf.space
ARG CONTROLLER_REVISION
ENV WORKFLOW_CONTROLLER_URL=$CONTROLLER_URL WORKFLOW_CONTROLLER_REVISION=$CONTROLLER_REVISION
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
# A strict whitelist: never COPY the controller, v1 verifier, generators or tests.
COPY workflow_lab /app/workflow_lab
RUN useradd --create-home --uid 10001 lab
USER lab
EXPOSE 8000
CMD ["python","-m","workflow_lab.app"]
